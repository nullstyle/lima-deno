{
  "name": "@nullstyle/lima",
  "version": "0.2.0",
  "license": "Apache-2.0",
  "exports": {
    ".": "./mod.ts",
    "./runner": "./src/runner.ts",
    "./config": "./src/config/mod.ts",
    "./image": "./src/image/mod.ts",
    "./testing": "./testing/mod.ts"
  },
  "imports": {
    "@nullstyle/qemu-img": "jsr:@nullstyle/qemu-img@^0.2",
    "@std/assert": "jsr:@std/assert@^1",
    "@std/crypto": "jsr:@std/crypto@^1"
  },
  "compilerOptions": {
    "strict": true,
    "verbatimModuleSyntax": true
  },
  "fmt": {
    "exclude": ["tests/fixtures/", "tests/.tmp/"]
  },
  "tasks": {
    "fmt": "deno fmt",
    "lint": "deno lint",
    "check": "deno fmt --check && deno lint && deno check .",
    "doc:lint": "deno doc --lint mod.ts src/runner.ts src/config/mod.ts src/image/mod.ts testing/mod.ts",
    "test": "deno test --allow-run=echo,cat,false,sleep --allow-read=tests,deno.json --allow-write=tests/.tmp tests/",
    "smoke": "deno run --allow-run --allow-read --allow-write --allow-env tools/lima_smoke.ts",
    "smoke:image": "deno run --allow-run --allow-read --allow-write --allow-env tools/image_smoke.ts",
    "publish:check": "deno run --allow-read tools/check_publish.ts",
    "publish:dry": "deno publish --dry-run"
  },
  "publish": {
    "include": [
      "mod.ts",
      "src/**",
      "testing/**",
      "README.md",
      "CHANGELOG.md",
      "LICENSE",
      "deno.json"
    ],
    "exclude": [
      "tests/**",
      "tools/**",
      "examples/**"
    ]
  }
}
